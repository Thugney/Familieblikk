DJANGO_SECRET_KEY=erstatt-med-lang-tilfeldig-hemmelighet
DJANGO_DEBUG=0
DJANGO_PREREGISTERED_LOGIN=1
DJANGO_ALLOWED_HOSTS=blikk.betilab.com
# Cloudflare håndterer HTTPS; appens lokale origin bruker HTTP på 6451.
DJANGO_HTTPS=0
DJANGO_TRUST_PROXY=1
CSRF_TRUSTED_ORIGINS=https://blikk.betilab.com
POSTGRES_DB=familieblikk
POSTGRES_USER=familieblikk_owner
POSTGRES_PASSWORD=erstatt-med-unikt-databasepassord
POSTGRES_APP_USER=familieblikk_app
POSTGRES_APP_PASSWORD=erstatt-med-et-annet-unikt-apppassord
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=6452
# Hosting bruker alltid host-nettverk og webport 6451; ingen APP_PORT/APP_BIND.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=
